# docker compose 用の設定例。`.env` にコピーして使用してください。
# cp .env.example .env

# 公開ポート
APP_PORT=3000

# アクセス保護（Basic認証）
#
# 社内限定で運用するため、原則として設定してください。
# 未設定の場合、URLに到達できる人はログイン画面まで進めます
# （価格データは個人ログインで守られますが、入口は開いた状態になります）。
#
# パスワードは半角英数のみにしてください。日本語や記号を使うと、
# ブラウザや機器によって送られ方が変わり、入力しても通らないことがあります。
# 生成例:
#   node -e "const{randomBytes:r}=require('node:crypto');const c='abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';const b=r(32);let s='';for(let i=0;i<32;i++)s+=c[b[i]%c.length];console.log(s)"
BASIC_AUTH_USER=sales
BASIC_AUTH_PASS=ここに生成した32文字程度のパスワードを設定してください

# 画面に出す時刻の時間帯（既定: Asia/Tokyo）。通常は設定不要です。
# DISPLAY_TZ=Asia/Tokyo

# 開発用（本番では設定しないでください）
#
# DISABLE_AUTH=true にするとログインを求めなくなります。
# 本番（Vercel / NODE_ENV=production）では設定されていても無視されます。
# DISABLE_AUTH=true
